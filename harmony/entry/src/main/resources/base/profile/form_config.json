{
  "forms": [
    {
      "name": "workdayGlow",
      "displayName": "$string:widget_name",
      "description": "$string:widget_description",
      "src": "./ets/pages/WidgetCard.ets",
      "uiSyntax": "arkts",
      "window": {
        "designWidth": 720,
        "autoDesignWidth": true
      },
      "colorMode": "auto",
      "isDefault": true,
      "updateEnabled": true,
      "updateDuration": 1,
      "defaultDimension": "2*2",
      "supportDimensions": [
        "1*2",
        "2*2",
        "2*4",
        "4*4"
      ]
    },
    {
      "name": "vocabulary",
      "displayName": "$string:vocabulary_name",
      "description": "$string:vocabulary_description",
      "src": "./ets/pages/VocabularyCard.ets",
      "uiSyntax": "arkts",
      "window": {
        "designWidth": 720,
        "autoDesignWidth": true
      },
      "colorMode": "auto",
      "isDefault": false,
      "updateEnabled": true,
      "updateDuration": 1,
      "defaultDimension": "2*2",
      "supportDimensions": [
        "2*2",
        "2*4",
        "4*4"
      ]
    }
  ]
}
